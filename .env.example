# Contraseña para entrar a /admin
ADMIN_PASSWORD=cambia-esto

# Clave usada para firmar la cookie de sesión (cualquier cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-tambien

# Dónde se guardan content.json y las fotos/videos subidos.
# En local puedes dejarlo vacío (usa ./data).
# En Railway, monta un Volume y pon DATA_DIR=/data para que
# el contenido no se pierda con cada deploy.
DATA_DIR=

# Railway asigna esto automáticamente, no hace falta tocarlo.
PORT=3000
